  "name": "Clipback_CLIP_Motion_Design",
  "notes": "Editable scene-graph project for the Clipback ($CLIP) motion-design film. Rendered by clipback-video/src/render.js, which reads this file for every creative value: palette, typography, text, world layout, camera keyframes, narration-derived sync marks and SFX cues. The narration MP3 is the master timing reference and is used unmodified (level-matched only). Pipeline: tools/analyze-vo.mjs -> tools/sfx.mjs -> tools/mix.mjs -> tools/render.mjs -> tools/qa.mjs.",
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 60,
    "duration": 44.0,
